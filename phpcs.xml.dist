<?xml version="1.0"?>
<ruleset name="MCP Ability Guard">
	<description>Coding standards for MCP Ability Guard.</description>

	<file>.</file>
	<exclude-pattern>/app/</exclude-pattern>
	<exclude-pattern>/assets/</exclude-pattern>
	<exclude-pattern>/tests/</exclude-pattern>
	<exclude-pattern>/vendor/</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg value="ps"/>

	<rule ref="WordPress">
		<!--
		The plugin owns three tables (requests, approvals, audit) and there is no
		Core API for them, so every read and write is necessarily a direct query.
		Table names are built from $wpdb->prefix plus a literal in Schema, never
		from input, and are passed through prepare()'s %i identifier placeholder.
		-->
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>

		<!--
		Caching is deliberately absent. The queue and the audit log are consulted
		to decide whether a change may proceed and to record what happened; a
		stale read there could approve something twice or lose an entry. These
		queries run only while an ability executes, never on front-end requests.
		-->
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mcp_ability_guard"/>
				<element value="McpAbilityGuard"/>
				<element value="mag_"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="proviso"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
